# =============================================================================
# Smart Expense Tracker — Backend Environment Variables
# =============================================================================
# Copy this file and rename it .env for local development.
# In production (Render), configure these values as Service Environment Variables.
# NEVER commit actual secrets to version control.
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
# For local development, H2 in-memory is used by default.
# No database configuration is needed for local dev — remove these or leave blank.
#
# For production MySQL, set all three:
SPRING_DATASOURCE_URL=jdbc:mysql://your-mysql-host:3306/your-database?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=your-db-username
SPRING_DATASOURCE_PASSWORD=your-db-password
#
# MySQL provider options for Render:
#   - PlanetScale (recommended, generous free tier, serverless)
#   - Railway MySQL add-on
#   - Render's own PostgreSQL (would require switching driver + dialect)
#   - Any external MySQL 8+ host
#
# When switching to MySQL, set in Render's environment:
#   SPRING_DATASOURCE_URL
#   SPRING_DATASOURCE_USERNAME
#   SPRING_DATASOURCE_PASSWORD
#   H2_CONSOLE_ENABLED=false

# ─── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — replace with a cryptographically random string.
# Minimum 32 characters. Use: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-key-minimum-32-characters

# Web JWT token expiry in milliseconds:
#   86400000  = 24 hours  (default)
#   3600000   = 1 hour    (more secure)
JWT_EXPIRATION_MS=86400000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your production frontend URL when deploying.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── H2 Console ───────────────────────────────────────────────────────────────
# Set to false in any deployed environment.
# The H2 console provides direct database access — never expose it publicly.
H2_CONSOLE_ENABLED=false

# ─── Server ───────────────────────────────────────────────────────────────────
# Render sets PORT automatically. Override only for local non-default port.
# PORT=8080
